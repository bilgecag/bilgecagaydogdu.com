{
  // Static-only Worker: no server code, Cloudflare just serves ./public
  "name": "bilgecagaydogdu-com",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "bilgecagaydogdu.com", "custom_domain": true },
    { "pattern": "www.bilgecagaydogdu.com", "custom_domain": true }
  ]
}
